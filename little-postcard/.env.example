# Where content comes from: "mock" (development fixtures) or "supabase".
# `npm run dev` defaults to mock when unset. Production builds REQUIRE this
# to be set, so development data can never ship by accident.
CONTENT_SOURCE=mock

# Required when CONTENT_SOURCE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL, used for Open Graph image links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
